# Supabase — copy to .env.local and fill in from your Supabase project settings
# (Project Settings → API). Both values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Used to build email-confirmation redirect links. In local dev keep as-is.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OPTIONAL — enables the hands-on "Practice" tab, where a learner writes a prompt
# and gets a real Claude response plus rubric coaching. Without it, Learn /
# Flashcards / Quiz all still work; Practice shows a "add your key" notice.
# Get a key at https://console.anthropic.com  (Settings → API Keys).
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-4-8).
# ANTHROPIC_MODEL=claude-opus-4-8
