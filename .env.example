# Supabase — copy to .env.local and fill in from your Supabase project settings
# (Project Settings → API). Both values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Used to build email-confirmation redirect links. In local dev keep as-is.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OPTIONAL operator key for the "Practice" tab. You usually DON'T need this:
# by default each learner brings their own Anthropic key (stored in their
# browser, never on the server), and with no key at all Practice falls back to
# a free offline rubric check. Set this only if you want the deployment to
# provide live Claude grading for everyone. Get a key at
# https://console.anthropic.com  (Settings → API Keys).
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-4-8).
# ANTHROPIC_MODEL=claude-opus-4-8
